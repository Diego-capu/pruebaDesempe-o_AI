# TechUni Admissions AI Assistant Configuration

# LLM API Provider Configuration
# Set your OpenAI API key or OpenAI-compatible endpoint key
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Set custom base URL if using an OpenAI-compatible provider (e.g. LocalAI, vLLM, Anyscale, Gemini OpenAI Endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model Selection
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.1

# RAG & ChromaDB Configuration
CHROMA_DB_DIR=./data/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.20

# Cache Settings
ENABLE_SEMANTIC_CACHE=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
